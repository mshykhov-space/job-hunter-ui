{
  "name": "job-hunter-ui",
  "private": true,
  "version": "0.17.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "rulesync:install": "rulesync install --config rulesync.jsonc --frozen",
    "rulesync:doctor": "rulesync doctor --config rulesync.jsonc --strict",
    "rulesync:dry-run": "rulesync generate --config rulesync.jsonc --input-root . --output-roots . --dry-run",
    "rulesync:generate": "rulesync generate --config rulesync.jsonc --input-root . --output-roots .",
    "rulesync:check": "rulesync generate --config rulesync.jsonc --input-root . --output-roots . --check",
    "rulesync:verify": "npm run rulesync:install && npm run rulesync:doctor && npm run rulesync:check",
    "agents:install": "rulesync install --config rulesync.jsonc --frozen",
    "agents:generate:dry": "rulesync generate --config rulesync.jsonc --input-root . --output-roots . --dry-run",
    "agents:generate": "rulesync generate --config rulesync.jsonc --input-root . --output-roots .",
    "agents:check": "rulesync generate --config rulesync.jsonc --input-root . --output-roots . --check",
    "ui:browsers:install": "playwright install chromium",
    "ui:detect": "impeccable detect --no-config --json",
    "ui:a11y": "node .rulesync/skills/ui-workbench/scripts/a11y.mjs",
    "ui:a11y:test": "node --test .rulesync/skills/ui-workbench/scripts/a11y-checks.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.0",
    "@ant-design/icons": "^6.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-query": "^5.90.21",
    "antd": "^6.3.1",
    "axios": "^1.13.5",
    "dompurify": "^3.3.2",
    "echarts": "^6.1.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-oidc-context": "^3.3.1",
    "react-resizable": "^3.1.3",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.39.1",
    "@playwright/mcp": "0.0.79",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-resizable": "^3.0.8",
    "@vitejs/plugin-react": "^5.1.1",
    "chrome-devtools-mcp": "1.7.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "impeccable": "3.5.0",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "playwright": "1.63.0-alpha-2026-08-05",
    "prettier": "^3.5.0",
    "rulesync": "16.9.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
